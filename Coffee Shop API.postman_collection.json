    {
      "name": "Payment",
      "description": "Midtrans Payment Gateway\n\nFlow:\n1. Create Transaction → dapat token & redirectUrl\n2. Buka redirectUrl untuk bayar via Midtrans Snap\n3. Setelah bayar, Midtrans kirim notifikasi ke webhook\n4. Cek status transaksi",
      "item": [
        {
          "name": "Create Midtrans Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('midtransToken', jsonData.token);",
                  "    pm.collectionVariables.set('midtransRedirectUrl', jsonData.redirectUrl);",
                  "    console.log('Redirect URL:', jsonData.redirectUrl);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/transaction/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "transaction", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Get Transaction Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/transaction/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "transaction", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Midtrans Webhook Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_status\": \"settlement\",\n  \"order_id\": \"CS-1-1685000000\",\n  \"transaction_id\": \"trx-midtrans-001\",\n  \"status_code\": \"200\",\n  \"gross_amount\": \"150000.00\",\n  \"payment_type\": \"bank_transfer\",\n  \"fraud_status\": \"accept\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payment/midtrans-notification",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "midtrans-notification"]
            }
          }
        },
        {
          "name": "[ADMIN] All Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "transactions"]
            }
          }
        }
      ]
    },
